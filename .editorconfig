root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[[shell]]
language_dialect   = bash
simplify           = true
binary_next_line   = false
case_indent        = true
space_redirects    = true
block_next_line    = true
minify             = false

[*.{c,cpp,hpp,h}]
indent_size =
