  UserMessaging = lib.mkOption {
    type = types.nullOr (
      types.submodule {
        freeformType = jsonFormat.type;
        options = {
          WhatsNew = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              Remove the "What's New" icon and menuitem. (*Deprecated*)
            '';
          };
          ExtensionRecommendations = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              If `false`, don't recommend extensions while the user is visiting web pages.
            '';
          };
          FeatureRecommendations = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              If `false`, don't recommend browser features.
            '';
          };
          UrlbarInterventions = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              If `false`, don't offer Firefox specific suggestions in the URL bar.
