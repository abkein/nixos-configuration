    '';
    example = false;
  };
  Watermark = lib.mkOption {
    type = types.nullOr (
      types.submodule {
        freeformType = jsonFormat.type;
        options = {
          Match = lib.mkOption { type = types.listOf (types.str); };
          Copy = lib.mkOption {
            type = types.nullOr (types.str);
            default = null;
            description = ''
              Text to display in the watermark. Falls back to the logged-in user's email, or a generic default, if unavailable. %t is replaced with the current timestamp, and %e with the logged-in user's email. Defaults to "%e"
            '';
          };
          Color = lib.mkOption {
            type = types.nullOr (types.str);
            default = null;
          };
          FontSize = lib.mkOption {
            type = types.nullOr (types.number);
            default = null;
            description = ''
              Font size of the watermark text, in CSS pixels. Defaults to 28, limit is 64.
            '';
          };
          Angle = lib.mkOption {
            type = types.nullOr (types.number);
            default = null;
            description = ''
              Rotation angle of the watermark text, in degrees. Defaults to -45.
            '';
          };
          Size = lib.mkOption {
            type = types.nullOr (types.number);
            default = null;
            description = ''
              Size of a single background tile, in CSS pixels. Defaults to 300, limit is 2048.
            '';
          };
          SecondaryCopy = lib.mkOption {
            type = types.nullOr (types.str);
            default = null;
            description = ''
              Template for a smaller second row of text below Copy. %t is replaced with the current timestamp, and %e with the logged-in user's email. Defaults to "%t"; set to an empty string to omit the second row.
            '';
          };
        };
      }
    );
    default = null;
    description = ''
      Display a tiled, diagonal watermark over a list of websites.

      See [Watermark](https://firefox-admin-docs.mozilla.org/reference/policies/watermark/).
    '';
    example = {
      Match = [
        "https://intranet.example.com/*"
        "https://*.corp.example.com/*"
      ];
      Copy = "CONFIDENTIAL";
      Color = "rgba(200, 0, 0, 0.2)";
      FontSize = 28;
      Angle = -45;
      SecondaryCopy = "%t - %e";
    };
  };
  WebsiteFilter = lib.mkOption {
    type = types.nullOr (
      types.submodule {
        freeformType = jsonFormat.type;
        options = {
          Block = lib.mkOption {
            type = types.nullOr (types.listOf (types.str));
            default = null;
          };
          Exceptions = lib.mkOption {
            type = types.nullOr (types.listOf (types.str));
            default = null;
          };
