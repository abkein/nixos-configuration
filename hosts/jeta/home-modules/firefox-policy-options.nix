          Bookmarks = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              A Boolean. Controls whether syncing bookmarks should be enabled.
            '';
          };
          History = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              A Boolean. Controls whether syncing history should be enabled.
