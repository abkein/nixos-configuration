              default = null;
              description = ''
                Offline Website Data (*Deprecated - use `Cookies` instead*)
              '';
            };
            Locked = lib.mkOption {
              type = types.nullOr (types.bool);
              default = null;
              description = ''
                Prevents the user from changing these preferences.
              '';
            };
            Exceptions = lib.mkOption {
              type = types.nullOr (types.listOf (types.str));
              default = null;
              description = ''
                (Firefox 154) A list of origins (not domains) whose cookies and site data are not cleared on shutdown. You must include `http` or `https`.
              '';
            };
          };
        })
      ]
    );
    default = null;
    description = ''
      Clear specified data on shutdown, such as History, Cookies, Logins, Cache, Form History, Site Preferences and Offline Website Data.

      See [SanitizeOnShutdown](https://firefox-admin-docs.mozilla.org/reference/policies/sanitizeonshutdown/).
    '';
    example = true;
  };
  SearchBar = lib.mkOption {
    type = types.nullOr (
      types.enum [
        "unified"
        "separate"
      ]
    );
    default = null;
    description = ''
      Set whether or not search bar is displayed.

      See [SearchBar](https://firefox-admin-docs.mozilla.org/reference/policies/searchbar/).
    '';
    example = "unified";
  };
  SearchEngines = lib.mkOption {
    type = types.nullOr (
      types.submodule {
        freeformType = jsonFormat.type;
        options = {
          Add = lib.mkOption {
            type = types.nullOr (
              types.listOf (
                types.submodule {
                  freeformType = jsonFormat.type;
                  options = {
                    Name = lib.mkOption {
                      type = types.str;
                      description = ''
                        (**required**): the name of the search engine.
                      '';
                    };
                    IconURL = lib.mkOption {
                      type = types.nullOr (types.str);
                      default = null;
                      description = ''
                        a URL for the icon to use.
                      '';
                    };
                    Alias = lib.mkOption {
                      type = types.nullOr (types.str);
                      default = null;
                      description = ''
                        a keyword to use for the engine.
                      '';
                    };
                    Description = lib.mkOption {
                      type = types.nullOr (types.str);
                      default = null;
                      description = ''
                        a description of the search engine.
                      '';
                    };
                    Encoding = lib.mkOption {
                      type = types.nullOr (types.str);
                      default = null;
                      description = ''
                        the query charset for the engine. Defaults to `UTF-8`.
                        Although there are five engines available in the ADMX template, there is no maximum number that can be specified — to add more in the ADMX template, duplicate the XML.
                      '';
                    };
                    Method = lib.mkOption {
                      type = types.nullOr (
                        types.enum [
                          "GET"
                          "POST"
                        ]
                      );
                      default = null;
                      description = ''
                        either [GET](https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Methods/GET) or [POST](https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Methods/POST).
                      '';
                    };
                    URLTemplate = lib.mkOption {
                      type = types.str;
                      description = ''
                        (**required**): the search URL with `{searchTerms}` to substitute for the search term.
                      '';
                    };
                    PostData = lib.mkOption {
                      type = types.nullOr (types.str);
                      default = null;
                      description = ''
                        the `POST` data as `name=value` pairs separated by `&`.
                      '';
                    };
                    SuggestURLTemplate = lib.mkOption {
                      type = types.nullOr (types.str);
                      default = null;
                      description = ''
                        a search suggestions URL with `{searchTerms}` to substitute for the search term.
                      '';
                    };
                  };
                }
              )
            );
            default = null;
            description = ''
              Add new search engines.
            '';
          };
          Default = lib.mkOption {
            type = types.nullOr (types.str);
            default = null;
            description = ''
              Set the default search engine.
            '';
          };
          DefaultPrivate = lib.mkOption {
            type = types.nullOr (types.str);
            default = null;
          };
          PreventInstalls = lib.mkOption {
            type = types.nullOr (types.bool);
            default = null;
            description = ''
              Prevent installing search engines from webpages.
            '';
          };
          Remove = lib.mkOption {
            type = types.nullOr (types.listOf (types.str));
            default = null;
            description = ''
              Hide built-in search engines.
            '';
          };
        };
      }
    );
    default = null;
    description = ''
      The following policies allow for configuring search engines in Firefox.

      See [SearchEngines](https://firefox-admin-docs.mozilla.org/reference/policies/searchengines/).
    '';
    example = {
      Default = "Example1";
      Add = [
        {
          Name = "Example1";
          URLTemplate = "https://www.example.org/q={searchTerms}";
          Method = "GET";
          IconURL = "https://www.example.org/favicon.ico";
          Alias = "example";
          Description = "Description";
          SuggestURLTemplate = "https://www.example.org/suggestions/q={searchTerms}";
        }
      ];
      PreventInstalls = true;
    };
  };
  SearchSuggestEnabled = lib.mkOption {
    type = types.nullOr (types.bool);
    default = null;
    description = ''
      Enable search suggestions.

      See [SearchSuggestEnabled](https://firefox-admin-docs.mozilla.org/reference/policies/searchsuggestenabled/).
    '';
    example = false;
  };
  SecurityDevices = lib.mkOption {
    type = types.nullOr (
      types.submodule {
        freeformType = types.str;
        options = {
          Add = lib.mkOption {
            type = types.nullOr (types.attrsOf (types.str));
            default = null;
            description = ''
              maps a device name to the full path of the module library on disk.
              The name is what the device is listed as in Firefox, and the path must be readable on the machine where Firefox runs.
            '';
          };
          Delete = lib.mkOption {
            type = types.nullOr (types.listOf (types.str));
            default = null;
            description = ''
              a list of device names to unload, using the name the module was added under.
              Removing a name that is not loaded is not an error.
            '';
          };
        };
      }
    );
    default = null;
    description = ''
      Install PKCS #11 modules.

      See [SecurityDevices](https://firefox-admin-docs.mozilla.org/reference/policies/securitydevices/).
    '';
    example = {
      Add = {
        "A Device" = "/path/to/library/for/device";
      };
    };
  };
  ShowHomeButton = lib.mkOption {
    type = types.nullOr (types.bool);
    default = null;
    description = ''
      Show the home button on the toolbar.

      See [ShowHomeButton](https://firefox-admin-docs.mozilla.org/reference/policies/showhomebutton/).
    '';
    example = true;
  };
  SitePolicies = lib.mkOption {
    type = types.nullOr (
      types.listOf (
        types.submodule {
          freeformType = jsonFormat.type;
          options = {
            Match = lib.mkOption {
              type = types.nullOr (types.listOf (types.str));
              default = null;
              description = ''
                a list of sites.
                An empty list or missing property means to match all sites.
              '';
            };
            Exceptions = lib.mkOption {
              type = types.nullOr (types.listOf (types.str));
              default = null;
              description = ''
                a list of sites which when matched bypasses this set of rules.
              '';
            };
            Policies = lib.mkOption {
              type = types.submodule {
                freeformType = jsonFormat.type;
                options = {
                  DisableJit = lib.mkOption {
                    type = types.nullOr (types.bool);
                    default = null;
                    description = ''
                      disables the JIT engine for the site when `true`.
                    '';
                  };
                  HttpsOnly = lib.mkOption {
                    type = types.nullOr (types.bool);
                    default = null;
                    description = ''
                      stops the site from being loaded over plain HTTP when `true`.
                      When it is `false`, HTTP is explicitly allowed for the site, which is how you carve a site out of a broader rule.
                    '';
                  };
                  DisableServiceWorkers = lib.mkOption {
                    type = types.nullOr (types.bool);
                    default = null;
                  };
                };
              };
              description = ''
                an object defining the site policies.
              '';
            };
          };
        }
      )
    );
    default = null;
    description = ''
      Fine grained control over policies for specific sites.

      See [SitePolicies](https://firefox-admin-docs.mozilla.org/reference/policies/sitepolicies/).
    '';
    example = [
      {
        Match = [ "*.example.com" ];
        Policies = {
          DisableJit = true;
        };
      }
      {
        Exceptions = [ "*.example.org" ];
        Policies = {
          DisableJit = true;
        };
      }
      {
        Match = [ "*.example.net" ];
        Policies = {
          HttpsOnly = true;
        };
      }
    ];
  };
  SkipTermsOfUse = lib.mkOption {
    type = types.nullOr (types.bool);
    default = null;
    description = ''
      Configure display settings for the Firefox Terms of Use and Privacy Notice on startup.

      See [SkipTermsOfUse](https://firefox-admin-docs.mozilla.org/reference/policies/skiptermsofuse/).
    '';
    example = true;
  };
