{
  "backup": {
    "database": {
      "cronExpression": "0 02 * * *",
      "enabled": false,
      "keepLastAmount": 14
    }
  },
  "ffmpeg": {
    "accel": "disabled",
    "accelDecode": true,
    "acceptedAudioCodecs": [
      "opus"
    ],
    "acceptedContainers": [
      "webm"
    ],
    "acceptedVideoCodecs": [
      "av1"
    ],
    "bframes": -1,
    "cqMode": "cqp",
    "crf": 23,
    "gopSize": 0,
    "maxBitrate": "0",
    "preferredHwDevice": "/dev/dri/renderD128",
    "preset": "ultrafast",
    "realtime": {
      "enabled": false,
      "resolutions": [
        480,
        720,
        1080
      ],
      "videoCodecs": [
        "h264",
        "hevc"
      ]
    },
    "refs": 0,
    "targetAudioCodec": "opus",
    "targetResolution": "2160",
    "targetVideoCodec": "av1",
    "temporalAQ": false,
    "threads": 4,
    "tonemap": "hable",
    "transcode": "required",
    "twoPass": false
  },
  "image": {
    "colorspace": "p3",
    "extractEmbedded": false,
    "fullsize": {
      "enabled": false,
      "format": "jpeg",
      "progressive": false,
      "quality": 80
    },
    "preview": {
      "format": "webp",
      "progressive": false,
      "quality": 100,
      "size": 1440
    },
    "thumbnail": {
      "format": "webp",
      "progressive": false,
      "quality": 80,
      "size": 250
    }
  },
  "integrityChecks": {
    "checksumFiles": {
      "cronExpression": "0 03 * * *",
      "enabled": true,
      "percentageLimit": 1,
      "timeLimit": 3600000
    },
    "missingFiles": {
      "cronExpression": "0 03 * * *",
      "enabled": true
    },
    "untrackedFiles": {
      "cronExpression": "0 03 * * *",
      "enabled": true
    }
  },
  "job": {
    "backgroundTask": {
      "concurrency": 1
    },
    "editor": {
      "concurrency": 1
    },
    "faceDetection": {
      "concurrency": 1
    },
    "integrityCheck": {
      "concurrency": 1
    },
    "library": {
      "concurrency": 1
    },
    "metadataExtraction": {
      "concurrency": 1
    },
    "migration": {
      "concurrency": 1
    },
    "notifications": {
      "concurrency": 1
    },
    "ocr": {
      "concurrency": 1
    },
    "search": {
      "concurrency": 1
    },
    "sidecar": {
      "concurrency": 1
    },
    "smartSearch": {
      "concurrency": 1
    },
    "thumbnailGeneration": {
      "concurrency": 1
    },
    "videoConversion": {
      "concurrency": 1
    },
    "workflow": {
      "concurrency": 1
    }
  },
  "library": {
    "scan": {
      "cronExpression": "0 0 * * *",
      "enabled": false
    },
    "watch": {
      "enabled": false
    }
  },
  "logging": {
    "enabled": true,
    "level": "log"
  },
  "machineLearning": {
    "availabilityChecks": {
      "enabled": true,
      "interval": 30000,
      "timeout": 2000
    },
    "clip": {
      "enabled": false,
      "modelName": "ViT-SO400M-16-SigLIP2-384__webli"
    },
    "duplicateDetection": {
      "enabled": false,
      "maxDistance": 0.01
    },
    "enabled": true,
    "facialRecognition": {
      "enabled": false,
      "maxDistance": 0.5,
      "minFaces": 5,
      "minScore": 0.7,
      "modelName": "antelopev2"
    },
    "ocr": {
      "enabled": false,
      "maxResolution": 736,
      "minDetectionScore": 0.5,
      "minRecognitionScore": 0.8,
      "modelName": "ESLAV__PP-OCRv5_mobile"
    },
    "urls": [
      "http://localhost:3003"
    ]
  },
  "map": {
    "darkStyle": "https://tiles.immich.cloud/v1/style/dark.json",
    "enabled": true,
    "lightStyle": "https://tiles.immich.cloud/v1/style/light.json"
  },
  "metadata": {
    "faces": {
      "import": true
    }
  },
  "newVersionCheck": {
    "channel": "stable",
    "enabled": false
  },
  "nightlyTasks": {
    "clusterNewFaces": false,
    "databaseCleanup": true,
    "generateMemories": true,
    "missingThumbnails": false,
    "startTime": "00:00",
    "syncQuotaUsage": true
  },
  "notifications": {
    "smtp": {
      "enabled": false,
      "from": "",
      "replyTo": "",
      "transport": {
        "host": "",
        "ignoreCert": false,
        "password": "",
        "port": 587,
        "secure": false,
        "username": ""
      }
    }
  },
  "oauth": {
    "accountManagementUrl": "",
    "allowInsecureRequests": false,
    "autoLaunch": false,
    "autoRegister": true,
    "buttonText": "Login with OAuth",
    "clientId": "",
    "clientSecret": "",
    "defaultStorageQuota": null,
    "enabled": false,
    "endSessionEndpoint": "",
    "issuerUrl": "",
    "mobileOverrideEnabled": false,
    "mobileRedirectUri": "",
    "profileSigningAlgorithm": "none",
    "prompt": "",
    "roleClaim": "immich_role",
    "scope": "openid email profile",
    "signingAlgorithm": "RS256",
    "storageLabelClaim": "preferred_username",
    "storageQuotaClaim": "immich_quota",
    "timeout": 30000,
    "tokenEndpointAuthMethod": "client_secret_post"
  },
  "passwordLogin": {
    "enabled": true
  },
  "reverseGeocoding": {
    "enabled": true
  },
  "server": {
    "externalDomain": "",
    "loginPageMessage": "",
    "publicUsers": true
  },
  "storageTemplate": {
    "enabled": true,
    "hashVerificationEnabled": true,
    "template": "{{album}}/{{y}}/{{MM}}/{{dd}}/{{filename}}"
  },
  "templates": {
    "email": {
      "albumInviteTemplate": "",
      "albumUpdateTemplate": "",
      "welcomeTemplate": ""
    }
  },
  "theme": {
    "customCss": ""
  },
  "trash": {
    "days": 30,
    "enabled": true
  },
  "user": {
    "deleteDelay": 7
  }
}
